{
  "permissions": {
    "allow": [
      "Bash(bash tool/verify.sh:*)",
      "Bash(bash tool/check_principles.sh)",
      "Bash(flutter pub get:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(flutter pub publish:*)",
      "Bash(dart pub publish:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/tool/hooks/guard_principles.dart\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/tool/hooks/format_dart.dart\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/tool/hooks/verify_on_stop.dart\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
